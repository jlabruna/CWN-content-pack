{
  "name": "cwn-content-pack",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "build:weapons": "node tools/build-weapon-compendium.mjs",
    "build:armor": "node tools/generate-armor-icons.mjs && node tools/build-armor-compendium.mjs",
    "build:ammunition": "node tools/generate-ammunition-icons.mjs && node tools/build-ammunition-compendium.mjs",
    "build": "npm run build:weapons && npm run build:armor && npm run build:ammunition",
    "validate": "node tools/validate-content.mjs",
    "verify:deterministic": "node tools/verify-deterministic-build.mjs vendor/swnr",
    "verify": "npm run validate && npm run verify:deterministic",
    "stage": "node tools/stage-release.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "yaml": "^2.8.0"
  }
}
