<section class="cwncp-catalogue">
  <p>{{localize "CWNContentPack.Catalogue.Intro"}}</p>

  <dl class="cwncp-catalogue__status">
    <div>
      <dt>{{localize "CWNContentPack.Catalogue.Expected"}}</dt>
      <dd>{{expected}}</dd>
    </div>
    <div>
      <dt>{{localize "CWNContentPack.Catalogue.Installed"}}</dt>
      <dd>{{installed}}</dd>
    </div>
  </dl>

  <button type="button" data-action="installCatalogue">
    <i class="fa-solid fa-download" aria-hidden="true"></i>
    {{localize "CWNContentPack.Catalogue.Install"}}
  </button>

  <p class="hint">{{localize "CWNContentPack.Catalogue.Safe"}}</p>
</section>
